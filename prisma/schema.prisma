// Matinee schema. One logical database (no sharding, ADR 0005) — a primary and a
// read replica, both reached through pooled (-pooler) connection strings built in code
// (src/db/clients.ts). Migrations use DATABASE_DIRECT_URL via prisma.config.ts (ADR 0010).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Cinema {
  id        String   @id
  name      String
  address   String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  screens   Screen[]

  @@map("cinemas")
}

model Screen {
  id         String     @id
  cinemaId   String     @map("cinema_id")
  name       String
  format     String     @default("Standard") @map("format")
  totalSeats Int        @map("total_seats")
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  cinema     Cinema     @relation(fields: [cinemaId], references: [id], onDelete: Cascade)
  showtimes  Showtime[]
  seats      Seat[]

  @@unique([cinemaId, name])
  @@map("screens")
}

/// A physical seat in a screen. Seats belong to the SCREEN, not to a showtime: the room's chairs do
/// not change between showings. Per-showtime availability (booked / held) is layered on later from
/// bookings and Redis holds, never stored here (ADR 0014). The unique key below also serves every
/// lookup by screen, so it needs no separate index.
model Seat {
  id       String    @id @default(uuid()) @db.Uuid
  screenId String    @map("screen_id")
  /// Row letter, "A".."Z". Single letters only, so plain text ordering is the physical order.
  row      String
  /// Seat number within the row, 1-based, left to right as seen from the seats.
  number   Int
  /// "standard" | "wheelchair". A string like Screen.format; validated by the API's Zod contract.
  kind     String    @default("standard")
  screen   Screen    @relation(fields: [screenId], references: [id], onDelete: Cascade)
  bookings Booking[]

  @@unique([screenId, row, number])
  @@map("seats")
}

model Showtime {
  id         String    @id @default(uuid()) @db.Uuid
  /**
   * TMDB movie id — plain integer with no FK because movies live in TMDB, not Postgres (ADR 0010).
   */
  movieId    Int       @map("movie_id")
  screenId   String    @map("screen_id")
  startsAt   DateTime  @map("starts_at") @db.Timestamptz(3)
  /**
   * Ticket price in minor units (whole integer pence, GBP; RULES A3). Named `priceCents` for historical reasons; renaming needs a migration.
   */
  priceCents Int       @map("price_cents")
  /**
   * When this showing was cancelled (ADR 0020). Nullable: a null means the showing is live; a set value is the
   * single durable source of truth that rejects new holds/checkouts and drives the cancelled-showtime refund job.
   */
  cancelledAt DateTime? @map("cancelled_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  screen     Screen    @relation(fields: [screenId], references: [id], onDelete: Cascade)
  bookings   Booking[]

  @@unique([screenId, startsAt])
  @@index([movieId, startsAt])
  @@map("showtimes")
}

/// One sold seat for one showtime. A booking is one ROW PER SEAT, so the constraint that makes double
/// booking impossible sits on the row that represents the sale. `reference` groups the seats confirmed
/// together (one "order"); a payments table can key on it later without touching the constraint.
///
/// Redis holds are the fast path that decides who may TRY to book; this unique key is the final guard that
/// decides who OWNS the seat, and it still holds if Redis is empty, wrong or down (ADR 0015).
///
/// Foreign keys are Restrict, not Cascade: a sale must not vanish because a showtime or seat was deleted.
model Booking {
  id         String   @id @default(uuid()) @db.Uuid
  /// Groups the seats confirmed in one request.
  reference  String   @db.Uuid
  showtimeId String   @map("showtime_id") @db.Uuid
  seatId     String   @map("seat_id") @db.Uuid
  /// The caller's client id. A stand-in until real auth exists, when it becomes a user id (ADR 0015).
  ownerId    String   @map("owner_id")
  /// The showtime's price per seat when it was booked, integer pence, GBP (RULES A3).
  priceCents Int      @map("price_cents")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  showtime   Showtime @relation(fields: [showtimeId], references: [id], onDelete: Restrict)
  seat       Seat     @relation(fields: [seatId], references: [id], onDelete: Restrict)

  /// The safety net (RULES D5.2). Its leading column also serves "which seats are sold for this showtime".
  @@unique([showtimeId, seatId])
  @@map("bookings")
}

/// One payment order: a Stripe PaymentIntent linked to the seats it pays for, the caller, and the client's
/// idempotency key (ADR 0019). `reference` is the order id and becomes `bookings.reference` on success, so the
/// charge, the order and the seat rows share one id. `seatIds` is the seats as validated at checkout (a snapshot,
/// the authoritative per-seat truth is the booking row + the unique key). Prices are captured at checkout so a
/// later price change cannot touch an in-flight order (RULES A3: whole pence).
model Order {
  id                    String   @id @default(uuid()) @db.Uuid
  reference             String   @unique @db.Uuid
  ownerId               String   @map("owner_id")
  showtimeId            String   @map("showtime_id") @db.Uuid
  seatIds               Json     @map("seat_ids")
  seatTotalCents        Int      @map("seat_total_cents")
  feeCents              Int      @map("fee_cents")
  totalCents            Int      @map("total_cents")
  currency              String
  stripePaymentIntentId String   @unique @map("stripe_payment_intent_id")
  /// The client's checkout idempotency key, scoped per owner (a key is not a secret and not unique across callers).
  idempotencyKey        String   @map("idempotency_key")
  /// 'requires_payment' | 'succeeded' | 'refunded' | 'failed'. Rebuildable from the ledger; kept for fast reads.
  status                String
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  ledger                LedgerEntry[]

  @@unique([ownerId, idempotencyKey])
  @@index([ownerId])
  @@map("orders")
}

/// The append-only financial record for an order (ADR 0019). One row per money movement: a charge (the Stripe
/// PaymentIntent) or a refund. `amountCents` is always positive; the direction is `kind`. `stripeObjectId` is
/// unique so a retried job can never record the same Stripe object twice. NEVER updated or deleted — corrections
/// are new rows, and the order's net position is `SUM(charge) - SUM(refund)` over these rows.
model LedgerEntry {
  id             String   @id @default(uuid()) @db.Uuid
  orderId        String   @map("order_id") @db.Uuid
  kind           String
  amountCents    Int      @map("amount_cents")
  stripeObjectId String   @unique @map("stripe_object_id")
  stripeEventId  String?  @map("stripe_event_id")
  reason         String
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@map("ledger_entries")
}

/// The webhook idempotency store (ADR 0019): every Stripe event id is recorded durably FIRST, before the 200,
/// so a re-delivered event is skipped by its primary key. `status` tracks processing; it is metadata, not money,
/// so the transition is the one allowed update.
model ProcessedStripeEvent {
  eventId         String    @id @map("event_id")
  type            String
  paymentIntentId String?   @map("payment_intent_id")
  status          String    @default("received")
  receivedAt      DateTime  @default(now()) @map("received_at") @db.Timestamptz(3)
  processedAt     DateTime? @map("processed_at") @db.Timestamptz(3)

  @@map("processed_stripe_events")
}
