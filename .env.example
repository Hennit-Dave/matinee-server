# Variable names only, no values. Copy to .env and fill in.
TMDB_READ_TOKEN=

# Neon, pooled (-pooler) hosts only (ADR 0007). Primary and read replica.
DATABASE_URL=
DATABASE_READ_URL=

# Railway Redis in production; redis://localhost:6379 for local dev (ADR 0008's addendum —
# "Starting Redis locally" in the README).
REDIS_URL=

# Optional. Defaults to 3000 if unset; a host (Railway) injects its own.
PORT=
