# Variable names only, no values. Copy to .env and fill in.
TMDB_READ_TOKEN=

# Neon, pooled (-pooler) hosts only (ADR 0007). Primary and read replica.
DATABASE_URL=
DATABASE_READ_URL=
# Neon unpooled (direct) primary host — required only by Prisma Migrate DDL (ADR 0010).
DATABASE_DIRECT_URL=

# Railway Redis in production; redis://localhost:6379 for local dev (ADR 0008's addendum —
# "Starting Redis locally" in the README).
REDIS_URL=

# Optional. The most seats of ONE showing that an install, and a network address, may hold at once (ADR 0018).
# Defaults: 8 per install, 16 per address. 0 turns a cap off.
HOLD_CAP_PER_OWNER=
HOLD_CAP_PER_ADDRESS=

# Optional. "loadtest" relaxes the traffic limits that a load test from one address cannot live with (slice 5e) and logs a
# warning at boot. Never set it in production. Unset or "default" is the shipped behaviour.
TRAFFIC_PROFILE=

# Optional. Defaults to 3000 if unset; a host (Railway) injects its own.
PORT=
