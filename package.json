{
  "name": "matinee-server",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "dev:api": "tsx watch --env-file-if-exists=.env src/api/main.ts",
    "start:api": "node --enable-source-maps --env-file-if-exists=.env dist/api/main.js",
    "test": "node --env-file-if-exists=.env --import tsx --test \"src/**/*.test.ts\"",
    "test:integration": "node --env-file-if-exists=.env --import tsx --test --test-concurrency=1 \"src/**/*.integration.test.ts\"",
    "db:generate": "node ./node_modules/prisma/build/index.js generate",
    "prebuild": "npm run db:generate",
    "pretypecheck": "npm run db:generate",
    "pretest": "npm run db:generate",
    "predev:api": "npm run db:generate"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@prisma/extension-read-replicas": "0.5.0",
    "express": "5.3.0",
    "ioredis": "5.11.1",
    "pg": "8.23.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "eslint": "10.14.0",
    "prisma": "7.10.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2"
  }
}
